# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
LAN_ONLY=False
CLOUD_TEXT_ONLY=False

# AI Provider Configuration
MODEL_PROVIDER=openai
ARCHIVE_ANALYSIS_PROVIDER=local

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_MODELS=gpt-4.1,gpt-4.1-mini,gpt-4.1-nano

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_LOCAL_ONLY=False

# Research vault: encrypted, append-only, delete-only through the app
RESEARCH_VAULT_ENABLED=True
RESEARCH_VAULT_KEY=
RESEARCH_VAULT_KEY_FILE=./research_vault.key

# TTS Configuration
# Options: elevenlabs, pyttsx3
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Audio Configuration
AUDIO_TEMP_DIR=./temp_audio
MAX_AUDIO_SIZE_MB=25

# Local ComfyUI Configuration
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_FALLBACK_URLS=http://localhost:8188

# Conversation Storage
CONVERSATION_STORAGE=sqlite
DB_PATH=./conversations.db

# Frontend Configuration
CORS_ORIGINS=http://192.168.0.12:*,http://localhost:*,http://127.0.0.1:*
